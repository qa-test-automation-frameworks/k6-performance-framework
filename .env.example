# Target selection
TARGET_ENV=local
BASE_URL=http://localhost:3000/api
TEST_PROFILE=validation

# Workload controls
TARGET_RPS=20
MAX_VUS=100
THINK_TIME_SECONDS=1
SUMMARY_NAME=load
ALLOW_NON_LOCAL_LOAD=false

# Authentication: supply a JSON array at runtime; never commit real tokens.
K6_USER_TOKENS=[]
AUTH_USER_COUNT=5

# Observability
K6_RUN_ID=local-development
INFLUXDB_RETENTION=7d
GRAFANA_URL=http://localhost:3001
