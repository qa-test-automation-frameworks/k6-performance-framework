FROM golang:1.26-alpine@sha256:7a3e50096189ad57c9f9f865e7e4aa8585ed1585248513dc5cda498e2f41812c AS builder
RUN apk add --no-cache git
RUN go install go.k6.io/xk6/cmd/xk6@v1.4.6
RUN xk6 build v2.0.0 \
  --with github.com/grafana/xk6-output-influxdb@1a24b707ff912e2098461e0794aeb21d45e099cb \
  --output /k6

FROM alpine:3.24@sha256:a2d49ea686c2adfe3c992e47dc3b5e7fa6e6b5055609400dc2acaeb241c829f4
COPY --from=builder /k6 /usr/bin/k6
WORKDIR /work
ENTRYPOINT ["k6"]
