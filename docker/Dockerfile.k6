FROM golang:1.26-alpine@sha256:0178a641fbb4858c5f1b48e34bdaabe0350a330a1b1149aabd498d0699ff5fb2 AS builder
RUN apk add --no-cache git
RUN go install go.k6.io/xk6/cmd/xk6@v1.4.6
RUN xk6 build v2.0.0 \
  --with github.com/grafana/xk6-output-influxdb@1a24b707ff912e2098461e0794aeb21d45e099cb \
  --output /k6

FROM alpine:3.24@sha256:5b02b42e375f7426f8d65c3af331ca05d9878f9989230354504e0b9dfd431f60
COPY --from=builder /k6 /usr/bin/k6
WORKDIR /work
ENTRYPOINT ["k6"]
