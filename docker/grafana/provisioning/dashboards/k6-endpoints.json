          "query": "from(bucket: \"k6\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"http_req_failed\" and r.environment == \"${environment}\" and r.run_id == \"${run_id}\") |> group(columns: [\"name\"]) |> aggregateWindow(every: 10s, fn: mean)"
